{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && cd client && npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/ai/test-key",
      "destination": "/api/test-key"
    },
    {
      "source": "/api/ai/parse-resume",
      "destination": "/api/parse"
    },
    {
      "source": "/api/ai/parse-jd",
      "destination": "/api/parse-jd"
    },
    {
      "source": "/api/ai/analyze-match",
      "destination": "/api/match"
    },
    {
      "source": "/api/ai/analyze-match-v2",
      "destination": "/api/match-v2"
    },
    {
      "source": "/api/ai/followup/question",
      "destination": "/api/supplement"
    },
    {
      "source": "/api/ai/followup/format",
      "destination": "/api/supplement"
    },
    {
      "source": "/api/ai/generate-resume",
      "destination": "/api/generate"
    },
    {
      "source": "/api/ai/preparations/:id/generate",
      "destination": "/api/preparation-ai?action=generate&id=:id"
    },
    {
      "source": "/api/ai/preparations/:id/blocks/:blockId/optimize",
      "destination": "/api/preparation-ai?action=optimize&id=:id&blockId=:blockId"
    },
    {
      "source": "/api/ai/preparations/:id/suggestions/:suggestionId/propose",
      "destination": "/api/preparation-ai?action=suggest&id=:id&suggestionId=:suggestionId"
    },
    {
      "source": "/api/ai/preparations/:id/interview/generate",
      "destination": "/api/preparation-ai?action=interview&id=:id"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth/[action]"
    },
    {
      "source": "/api/data/:path*",
      "destination": "/api/data/[...path]"
    },
    {
      "source": "/api/public/portfolios/:slug",
      "destination": "/api/public/[slug]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
