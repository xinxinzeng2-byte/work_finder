# DeepSeek API Key（用户可在前端设置页填入，也可在此处配置默认值）
DEEPSEEK_API_KEY=

# 服务端口
PORT=3000

# 前端地址（用于 CORS）
CLIENT_URL=http://localhost:5173

# Neon pooled connection string
DATABASE_URL=

# JWT signing secret（至少 32 个随机字符）
JWT_SECRET=

# API Key 加密密钥（建议与 JWT_SECRET 使用不同的随机值；未配置时回退使用 JWT_SECRET）
API_KEY_ENCRYPTION_SECRET=
